<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<GridPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.warehouse.controller.StoreOwnerDialogController" hgap="14" vgap="14" alignment="CENTER" style="-fx-padding: 28; -fx-background-radius: 16; -fx-background-color: #fff;">
    <Label text="Nom:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="nameField" promptText="Entrez le nom" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Label text="Contact:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="contactField" promptText="Entrez le contact" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    <HBox spacing="18" alignment="CENTER" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2">
        <Button fx:id="okButton" text="OK">
            <tooltip><Tooltip text="Valider"/></tooltip>
        </Button>
        <Button fx:id="cancelButton" text="Annuler">
            <tooltip><Tooltip text="Annuler"/></tooltip>
        </Button>
    </HBox>
    <Label fx:id="errorLabel" styleClass="errorLabel" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
</GridPane> 