<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.warehouse.controller.TransactionOverlayController" styleClass="overlay-dialog" spacing="16" prefWidth="700" prefHeight="600" maxWidth="900" maxHeight="800">
    <!-- Header -->
    <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 0 0 16 0;">
        <Label text="💰" style="-fx-font-size: 24px;"/>
        <Label fx:id="dialogTitle" text="Ajouter une transaction" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    </HBox>
    
    <!-- Scrollable Form Content -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="12" style="-fx-padding: 8;">
            <GridPane hgap="12" vgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="150" prefWidth="150"/>
                    <ColumnConstraints minWidth="350" prefWidth="400" hgrow="ALWAYS"/>
                </columnConstraints>
                
                <Label text="📋 Type:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="typeComboBox" promptText="💼 Sélectionner le type" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="400" maxWidth="Infinity" style="-fx-background-color: white; -fx-text-fill: #2c3e50;"/>
                
            <Label text="🛏️ Matelas / Référence:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="mattressComboBox" promptText="Choisir un matelas avec référence" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="400" maxWidth="Infinity"/>
                
                <Label text="📦 Quantité:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                <TextField fx:id="quantityField" promptText="Nombre de matelas" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="400" maxWidth="Infinity"/>
                
                <Label text="💰 Prix unitaire (DT):" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                <TextField fx:id="unitPriceField" promptText="Coût d'achat" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="400" maxWidth="Infinity" editable="false"/>
                
                <Label text="💵 Prix de vente (DT):" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
                <TextField fx:id="salePriceField" promptText="Prix par unité" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="400" maxWidth="Infinity"/>
                
                <Label text="🧮 Total (DT):" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-weight: bold;"/>
                <TextField fx:id="totalPriceField" promptText="Calculé automatiquement" GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="400" maxWidth="Infinity" editable="false"/>
                
                <Label text="🏪 Propriétaire:" GridPane.columnIndex="0" GridPane.rowIndex="6" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="storeOwnerComboBox" promptText="Sélectionner un propriétaire" GridPane.columnIndex="1" GridPane.rowIndex="6" prefWidth="400" maxWidth="Infinity"/>
                
                <Label text="📝 Notes:" GridPane.columnIndex="0" GridPane.rowIndex="7" style="-fx-font-weight: bold;"/>
                <TextField fx:id="notesField" promptText="Notes ou destination" GridPane.columnIndex="1" GridPane.rowIndex="7" prefWidth="400" maxWidth="Infinity"/>
            </GridPane>
            <Label text="ℹ️ « Retour » sert à enregistrer qu’un matelas prêté revient en stock. « Réception » correspond à une nouvelle entrée fournisseur."
                   wrapText="true"
                   style="-fx-font-size: 12px; -fx-text-fill: #4b5563; -fx-padding: 4 0 0 0;"/>
            
            <!-- Lending specific fields -->
            <VBox fx:id="lendingFieldsBox" spacing="8" visible="false">
                <Label text="📅 Date de retour prévue:" style="-fx-font-weight: bold;"/>
                <DatePicker fx:id="expectedReturnDatePicker" promptText="Sélectionner une date" prefWidth="400" maxWidth="Infinity"/>
            </VBox>
            
            <!-- Transfer specific fields -->
            <VBox fx:id="destinationBox" spacing="8" visible="false">
                <Label text="📍 Destination:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="destinationField" promptText="Lieu de destination" prefWidth="400" maxWidth="Infinity"/>
            </VBox>
            
            <!-- Return specific fields -->
            <VBox fx:id="returnFieldsBox" spacing="8" visible="false">
                <Label text="🏪 Retour de qui:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="returnFromComboBox" promptText="Sélectionner le propriétaire" prefWidth="400" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </ScrollPane>
    
    <!-- Buttons -->
    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 16 0 0 0;">
        <Button text="✖ Annuler" onAction="#handleCancel" styleClass="button-accent-orange"/>
        <Button text="✔ Valider" onAction="#handleOk" styleClass="button-accent-green"/>
    </HBox>
</VBox> 