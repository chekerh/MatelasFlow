<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.warehouse.controller.InventoryController" spacing="16" alignment="TOP_CENTER" stylesheets="/css/modern.css">
    <Label text="Gestion des matelas" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" styleClass="table-scroll">
        <TableView fx:id="mattressTable" prefHeight="400" minWidth="900">
            <columns>
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="200" />
                <TableColumn fx:id="sizeColumn" text="Taille" prefWidth="140" />
                <TableColumn fx:id="brandColumn" text="Référence" prefWidth="200" />
                <TableColumn fx:id="quantityColumn" text="Quantité" prefWidth="120" />
                <TableColumn fx:id="unitPriceColumn" text="Prix unitaire (DT)" prefWidth="140" />
                <TableColumn fx:id="prixColumn" text="Prix de vente (DT)" prefWidth="140" />
            </columns>
        </TableView>
    </ScrollPane>
    <HBox spacing="14" alignment="CENTER" styleClass="toolbar">
        <Button fx:id="addButton" text="Ajouter" onAction="#handleAdd">
            <tooltip><Tooltip text="Ajouter un matelas"/></tooltip>
        </Button>
        <Button fx:id="editButton" text="Modifier" onAction="#handleEdit">
            <tooltip><Tooltip text="Modifier le matelas sélectionné"/></tooltip>
        </Button>
        <Button fx:id="deleteButton" text="Supprimer" onAction="#handleDelete" styleClass="button-danger">
            <tooltip><Tooltip text="Supprimer le matelas sélectionné"/></tooltip>
        </Button>
        <Button fx:id="refreshButton" text="Rafraîchir" onAction="#handleRefresh">
            <tooltip><Tooltip text="Rafraîchir la liste"/></tooltip>
        </Button>
    </HBox>
    <Label fx:id="errorLabel" styleClass="errorLabel" />
</VBox> 