<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.warehouse.controller.DashboardController" 
           stylesheets="/css/modern.css" styleClass="root dashboard">
    
    <!-- Main Dashboard Content -->
    <BorderPane styleClass="dashboard-content">
        <!-- Top Section -->
        <top>
            <HBox styleClass="dashboard-top" alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 18 32;">
                <!-- Left: Logo and App Name -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <ImageView fx:id="logoImage" fitHeight="40" fitWidth="40" pickOnBounds="true" preserveRatio="true"/>
                    <VBox spacing="2">
                        <Label text="MatelasPro" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <Label text="Gestion d'Entrepôt" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                    </VBox>
                </HBox>

                <!-- Arabic duaa centered between title and welcome -->
                <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <TextFlow textAlignment="CENTER">
                        <Text fx:id="duaaHeadingText" styleClass="duaa-heading"/>
                    </TextFlow>
                    <TextFlow textAlignment="CENTER">
                        <Text fx:id="duaaText" styleClass="duaa-text"/>
                    </TextFlow>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Right: Welcome, user, actions -->
                <HBox alignment="CENTER_RIGHT" spacing="16">
                    <Label fx:id="welcomeLabel" text="Bienvenue!" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" prefWidth="220"/>
                    <Button fx:id="darkModeButton" text="Mode Sombre" onAction="#toggleDarkMode" styleClass="dashboard-button"/>
                    <Button fx:id="powerButton" text="Éteindre" onAction="#handleExit" styleClass="dashboard-button button-danger"/>
                    <Button fx:id="logoutButton" text="Déconnexion" onAction="#handleLogout" styleClass="dashboard-button"/>
                </HBox>
            </HBox>
        </top>
        
        <!-- Main Content -->
        <center>
            <HBox spacing="0">
                <!-- Navigation Panel -->
                <VBox fx:id="navBox" styleClass="nav-panel" alignment="TOP_CENTER" spacing="14" style="-fx-padding: 28 16;">
                    <Button text="Inventaire" onAction="#showInventory" styleClass="nav-button"/>
                    <Button text="Transactions" onAction="#showTransactions" styleClass="nav-button"/>
                    <Button text="Propriétaires" onAction="#showStoreOwners" styleClass="nav-button"/>
                    <Button text="Utilisateurs" onAction="#showUserManagement" styleClass="nav-button" fx:id="userManagementButton"/>
                    <Button text="Statistiques" onAction="#showStatistics" styleClass="nav-button"/>
                    <Button text="Rapports" onAction="#showReports" styleClass="nav-button"/>
                    <Button text="Surveillance" onAction="#showAdminLogs" styleClass="nav-button" fx:id="adminLogsButton"/>
                    <Button text="Fonctionnalités Avancées" onAction="#showAdvancedFeatures" styleClass="nav-button" fx:id="advancedFeaturesButton"/>
                </VBox>
                
                <!-- Content Area -->
                <VBox fx:id="contentPane" styleClass="content-area" HBox.hgrow="ALWAYS">
                    <!-- Notification Area -->
                    <VBox fx:id="notificationArea" styleClass="notification-area" visible="false" managed="false" style="-fx-padding: 10;">
                        <Label fx:id="notificationLabel" styleClass="notification-label" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    
                    <!-- Main Content -->
                    <Region VBox.vgrow="ALWAYS"/>
                </VBox>
            </HBox>
        </center>
    </BorderPane>
    
    <!-- Overlay for dialogs -->
    <StackPane fx:id="overlayPane" visible="false" managed="false" styleClass="overlay-pane" alignment="CENTER"/>
    
</StackPane> 