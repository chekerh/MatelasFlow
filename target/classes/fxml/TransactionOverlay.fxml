<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.warehouse.controller.TransactionOverlayController" styleClass="overlay-dialog" spacing="16" prefWidth="1000" prefHeight="700" maxWidth="1400" maxHeight="900">
    <!-- Header -->
    <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 0 0 16 0;">
        <Label text="💰" style="-fx-font-size: 24px;"/>
        <Label fx:id="dialogTitle" text="Ajouter une transaction" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    </HBox>
    
    <!-- Form Content -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
        <VBox spacing="16" style="-fx-padding: 8;">
            <GridPane hgap="12" vgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="150" prefWidth="180"/>
                    <ColumnConstraints minWidth="400" prefWidth="500" hgrow="ALWAYS"/>
                </columnConstraints>
                
                <Label text="📋 Type:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="typeComboBox" promptText="💼 Sélectionner le type" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="500" maxWidth="Infinity" style="-fx-background-color: white; -fx-text-fill: #2c3e50;"/>
                
            <Label fx:id="mattressLabel" text="🛏️ Matelas / Référence:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="mattressComboBox" promptText="Choisir un matelas avec référence" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="500" maxWidth="Infinity"/>
                
                <Label fx:id="quantityLabel" text="📦 Quantité:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                <TextField fx:id="quantityField" promptText="Nombre de matelas" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="500" maxWidth="Infinity"/>
                
                <Label fx:id="salePriceLabel" text="💵 Prix de vente (DT):" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                <TextField fx:id="salePriceField" promptText="Prix par unité" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="500" maxWidth="Infinity"/>
                
                <Label fx:id="totalPriceLabel" text="🧮 Total (DT):" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
                <TextField fx:id="totalPriceField" promptText="Calculé automatiquement" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="500" maxWidth="Infinity" editable="false"/>
                
                <Label fx:id="storeOwnerLabel" text="🏪 Propriétaire:" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="storeOwnerComboBox" promptText="Sélectionner un propriétaire" GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="500" maxWidth="Infinity"/>
                
                <Label fx:id="notesLabel" text="📝 Notes:" GridPane.columnIndex="0" GridPane.rowIndex="6" style="-fx-font-weight: bold;"/>
                <TextField fx:id="notesField" promptText="Notes ou destination" GridPane.columnIndex="1" GridPane.rowIndex="6" prefWidth="500" maxWidth="Infinity"/>
            </GridPane>
            
            <!-- Pack specific fields -->
            <VBox fx:id="packFieldsBox" spacing="12" visible="false">
                <Label text="📦 Configuration du Pack" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Sélectionnez un matelas ci-dessous pour l'ajouter automatiquement au pack:" style="-fx-font-size: 12px; -fx-text-fill: #4b5563;"/>
                
                <GridPane hgap="12" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150" prefWidth="180"/>
                        <ColumnConstraints minWidth="400" prefWidth="500" hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="100" prefWidth="120"/>
                    </columnConstraints>
                    
                    <Label text="🛏️ Sélectionner:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="packMattressSelector" promptText="Choisir un matelas" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="500" maxWidth="Infinity" onAction="#handlePackMattressSelected"/>
                    <Button text="➕ Ajouter" onAction="#handleQuickAddPackItem" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="button-accent-green" prefWidth="120"/>
                </GridPane>
                
                <Separator/>
                
                <Label text="📋 Articles dans le pack:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                
                <VBox fx:id="packItemsContainer" spacing="8" style="-fx-background-color: transparent; -fx-max-height: 300;">
                    <!-- Pack items will be added dynamically here -->
                </VBox>
                
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button text="➕ Ajouter manuellement" onAction="#handleAddPackItem" styleClass="button-accent-green"/>
                </HBox>
                
                <Separator/>
                
                <GridPane hgap="12" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150" prefWidth="180"/>
                        <ColumnConstraints minWidth="400" prefWidth="500" hgrow="ALWAYS"/>
                    </columnConstraints>
                    
                    <Label text="💵 Prix Total du Pack (DT):" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="packTotalPriceField" promptText="Prix total du pack" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="500" maxWidth="Infinity"/>
                </GridPane>
            </VBox>
            <Label text="ℹ️ « Retour » sert à enregistrer qu’un matelas prêté revient en stock. « Réception » correspond à une nouvelle entrée fournisseur."
                   wrapText="true"
                   style="-fx-font-size: 12px; -fx-text-fill: #4b5563; -fx-padding: 4 0 0 0;"/>
            
            <!-- Lending specific fields -->
            <VBox fx:id="lendingFieldsBox" spacing="8" visible="false">
                <Label text="📅 Date de retour prévue:" style="-fx-font-weight: bold;"/>
                <DatePicker fx:id="expectedReturnDatePicker" promptText="Sélectionner une date" prefWidth="500" maxWidth="Infinity"/>
            </VBox>
            
            <!-- Transfer specific fields -->
            <VBox fx:id="destinationBox" spacing="8" visible="false">
                <Label text="📍 Destination:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="destinationField" promptText="Lieu de destination" prefWidth="500" maxWidth="Infinity"/>
            </VBox>
            
            <!-- Return specific fields -->
            <VBox fx:id="returnFieldsBox" spacing="8" visible="false">
                <Label text="🏪 Retour de qui:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="returnFromComboBox" promptText="Sélectionner le propriétaire" prefWidth="500" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </ScrollPane>
    
    <!-- Buttons -->
    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 16 0 0 0;">
        <Button text="✖ Annuler" onAction="#handleCancel" styleClass="button-accent-orange"/>
        <Button text="✔ Valider" onAction="#handleOk" styleClass="button-accent-green"/>
    </HBox>
</VBox> 