<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.warehouse.controller.MattressDialogController" styleClass="large-dialog">
    <top>
        <HBox alignment="CENTER" spacing="12" styleClass="panel-accent" style="-fx-padding: 18 0 18 0;">
            <Label text="🛏️" style="-fx-font-size: 32px; -fx-text-fill: #fff;" />
            <Label text="Ajouter / Modifier un Matelas" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #6a1b9a;" />
        </HBox>
    </top>
    <center>
        <GridPane hgap="14" vgap="18" alignment="CENTER" style="-fx-padding: 32; -fx-background-radius: 24; -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #fbc2eb 0%, #a6c1ee 100%);">
            <Label text="🛏️ Type de matelas:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="typeField" promptText="Entrez le type" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="📏 Taille:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="sizeField" promptText="Entrez la taille" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="🔖 Référence:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="referenceField" promptText="Entrez la référence" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="💰 Prix unitaire (DT):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="unitPriceField" promptText="Entrez le coût" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="💵 Prix de vente (DT):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="prixField" promptText="Entrez le prix de vente" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="🔢 Quantité:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="quantityField" promptText="Entrez la quantité" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <HBox spacing="18" alignment="CENTER" GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.columnSpan="2">
                <Button fx:id="okButton" text="✔ Valider">
                    <tooltip><Tooltip text="Valider"/></tooltip>
                </Button>
                <Button fx:id="cancelButton" text="✖ Annuler">
                    <tooltip><Tooltip text="Annuler"/></tooltip>
                </Button>
            </HBox>
            <Label fx:id="errorLabel" styleClass="errorLabel" GridPane.rowIndex="7" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
        </GridPane>
    </center>
</BorderPane> 