<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.warehouse.controller.LoginController"
           fx:id="rootContainer"
           stylesheets="/css/modern.css"
           styleClass="root login-background">

    <VBox alignment="CENTER" spacing="24" StackPane.alignment="CENTER">

        <VBox alignment="CENTER" spacing="20" styleClass="login-card">

            <VBox alignment="CENTER" spacing="12" styleClass="login-header">
                <ImageView fx:id="logoImage"
                           fitHeight="88"
                           fitWidth="88"
                           preserveRatio="true"
                           pickOnBounds="true"/>
                <Label text="MatelasPro" styleClass="login-title"/>
                <Label text="Gestion d'entrepôt, simplifiée."
                       styleClass="login-subtitle"/>
            </VBox>

            <VBox alignment="CENTER" spacing="16" fx:id="loginPane" styleClass="login-form">

                <VBox spacing="8" styleClass="login-field">
                    <Label text="Nom d'utilisateur" styleClass="field-label"/>
                    <TextField fx:id="usernameField"
                               promptText="Entrer votre identifiant"
                               styleClass="login-text-field"/>
                </VBox>

                <VBox spacing="8" styleClass="login-field">
                    <Label text="Mot de passe" styleClass="field-label"/>
                    <PasswordField fx:id="passwordField"
                                   promptText="Entrer votre mot de passe"
                                   styleClass="login-password-field"/>
                </VBox>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <CheckBox fx:id="rememberUsernameCheckBox" text="Se souvenir du nom d'utilisateur" styleClass="login-checkbox"/>
                </HBox>

                <Label fx:id="errorLabel"
                       styleClass="login-error-label"/>

                <Button fx:id="loginButton"
                        text="Se connecter"
                        onAction="#handleLogin"
                        styleClass="login-button"/>

                <Button text="Créer un compte"
                        onAction="#handleSignUp"
                        styleClass="signup-button"/>
            </VBox>

            <Separator styleClass="login-separator"/>

            <VBox alignment="CENTER" spacing="4" styleClass="login-footer">
                <Label text="🔐 Système Sécurisé" styleClass="login-footer-title"/>
                <Label text="© 2024 MatelasPro - Tous droits réservés" styleClass="login-footer-caption"/>
            </VBox>
        </VBox>

        <Label text="Astuce : utilisez le bouton vert de macOS pour agrandir la fenêtre."
               styleClass="login-hint"/>
    </VBox>
</StackPane>