<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" spacing="10" alignment="TOP_CENTER">
    <Label text="Warehouse Statistics & Reports" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
    <HBox spacing="20" alignment="CENTER">
        <Label fx:id="stockLabel" text="Stock: " />
        <Label fx:id="salesLabel" text="Total Sales: " />
        <Label fx:id="returnsLabel" text="Total Returns: " />
        <Label fx:id="lendsLabel" text="Total Lends: " />
    </HBox>
    <HBox spacing="10" alignment="CENTER">
        <Label text="Filter by Date:" />
        <DatePicker fx:id="filterDatePicker" />
        <Label text="Type:" />
        <ComboBox fx:id="typeComboBox" />
        <Button fx:id="filterButton" text="Filter" />
        <Button fx:id="resetButton" text="Reset" />
    </HBox>
    <TableView fx:id="transactionTable" prefHeight="300" prefWidth="900">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="40" />
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="120" />
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="80" />
            <TableColumn fx:id="mattressIdColumn" text="Mattress ID" prefWidth="80" />
            <TableColumn fx:id="quantityColumn" text="Quantity" prefWidth="80" />
            <TableColumn fx:id="storeOwnerIdColumn" text="Store Owner ID" prefWidth="100" />
            <TableColumn fx:id="expectedReturnDateColumn" text="Expected Return" prefWidth="120" />
            <TableColumn fx:id="notesColumn" text="Notes" prefWidth="200" />
        </columns>
    </TableView>
    <Label fx:id="errorLabel" textFill="red" />
</VBox> 