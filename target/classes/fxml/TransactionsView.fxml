<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.warehouse.controller.TransactionsController"
      spacing="16" alignment="TOP_CENTER" stylesheets="/css/modern.css">
    <Label text="Gestion des transactions" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" styleClass="table-scroll">
        <TableView fx:id="transactionTable" prefHeight="400" minWidth="1100" styleClass="transactions-table">
            <columns>
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="140" />
                <TableColumn fx:id="mattressNameColumn" text="Matelas" prefWidth="220"/>
                <TableColumn fx:id="quantityColumn" text="Quantité" prefWidth="90" />
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="130" />
                <TableColumn fx:id="prixColumn" text="Prix (DT)" prefWidth="130" />
                <TableColumn fx:id="totalPriceColumn" text="Total (DT)" prefWidth="140" />
                <TableColumn fx:id="storeOwnerNameColumn" text="Propriétaire" prefWidth="140"/>
                <TableColumn fx:id="notesColumn" text="Notes" prefWidth="160" />
                <TableColumn fx:id="expectedReturnDateColumn" text="Date Retour" prefWidth="140" />
                <TableColumn fx:id="addMattressColumn" text="Ajouter Matelas" prefWidth="160" sortable="false" />
            </columns>
        </TableView>
    </ScrollPane>
    <HBox spacing="14" alignment="CENTER">
        <Button fx:id="addButton" text="Ajouter une transaction" onAction="#handleAdd">
            <tooltip><Tooltip text="Ajouter une transaction"/></tooltip>
        </Button>
        <Button fx:id="refreshButton" text="Rafraîchir" onAction="#handleRefresh">
            <tooltip><Tooltip text="Rafraîchir la liste"/></tooltip>
        </Button>
        <Button fx:id="pdfReportButton" text="Générer PDF" onAction="#handlePdfReport">
            <tooltip><Tooltip text="Générer le rapport PDF du jour sélectionné"/></tooltip>
        </Button>
        <Button fx:id="deleteButton" text="Supprimer" onAction="#handleDelete">
            <tooltip><Tooltip text="Supprimer la transaction sélectionnée"/></tooltip>
        </Button>
        <DatePicker fx:id="reportDatePicker" promptText="Date du rapport" />
    </HBox>
    <Label fx:id="errorLabel" styleClass="errorLabel" />
</VBox> 