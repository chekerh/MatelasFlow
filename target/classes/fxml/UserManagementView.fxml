<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.warehouse.controller.UserManagementController"
      spacing="16" alignment="TOP_CENTER" stylesheets="/css/modern.css">
    <Label text="Gestion des employés" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
    <TableView fx:id="userTable" prefHeight="400" prefWidth="700">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50" />
            <TableColumn fx:id="usernameColumn" text="Nom d'utilisateur" prefWidth="200" />
            <TableColumn fx:id="roleColumn" text="Rôle" prefWidth="100" />
        </columns>
    </TableView>
    <HBox spacing="14" alignment="CENTER">
        <Button fx:id="addButton" text="Ajouter" onAction="#handleAdd">
            <tooltip><Tooltip text="Ajouter un employé"/></tooltip>
        </Button>
        <Button fx:id="editButton" text="Modifier" onAction="#handleEdit">
            <tooltip><Tooltip text="Modifier l'employé sélectionné"/></tooltip>
        </Button>
        <Button fx:id="deleteButton" text="Supprimer" onAction="#handleDelete">
            <tooltip><Tooltip text="Supprimer l'employé sélectionné"/></tooltip>
        </Button>
        <Button fx:id="refreshButton" text="Rafraîchir" onAction="#handleRefresh">
            <tooltip><Tooltip text="Rafraîchir la liste"/></tooltip>
        </Button>
    </HBox>
    <Label fx:id="errorLabel" styleClass="errorLabel" />
</VBox> 